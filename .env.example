# Скопируй в .env и заполни. Файл .env в git не попадает.

# --- Discord ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# ID сервера, где работает бот (ПКМ по серверу -> Копировать ID)
DISCORD_GUILD_ID=

# --- Внутренние пароли (генерируются scripts/setup.sh) ---
LAVALINK_PASSWORD=
YT_CIPHER_TOKEN=

# --- Веб-панель ---
PANEL_PASSWORD=
PANEL_HOST_PORT=8090

# --- YouTube (OAuth через отдельный Google-аккаунт, см. README) ---
YOUTUBE_OAUTH_ENABLED=true
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_OAUTH_SKIP_INIT=false

# --- Spotify (необязательно: без ключей работает через spotify-tokener) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_PREFER_PARTNER_API=true

# --- Apple Music (необязательно: токен подтягивается автоматически) ---
APPLE_MUSIC_TOKEN=

# --- Яндекс Музыка: источник включится, как только задан токен ---
YANDEX_MUSIC_TOKEN=
YANDEX_PROXY_URL=
YANDEX_PROXY_USERNAME=
YANDEX_PROXY_PASSWORD=

# --- VK Музыка: нужен токен и прокси в РФ ---
VK_MUSIC_TOKEN=
VK_PROXY_URL=
VK_PROXY_USERNAME=
VK_PROXY_PASSWORD=

# --- Мониторинг: вебхук Discord для уведомлений (можно задать и в панели) ---
ALERT_WEBHOOK_URL=
